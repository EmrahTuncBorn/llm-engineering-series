# =====================================================================
# Environment variables template
#
#   1. Copy this file to ".env"   (cp .env.example .env)
#   2. Fill in the values.
#   3. ".env" is listed in .gitignore and never reaches the repository.
#      NEVER put real keys in this file (.env.example).
# =====================================================================

# --- Gemini API -------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# langchain-google-genai reads GOOGLE_API_KEY first, then GEMINI_API_KEY.
GOOGLE_API_KEY=

# Chat model. Prefer a fixed version name: "-latest" aliases are
# hot-swapped on new releases, which hurts reproducibility.
# Current names: https://ai.google.dev/gemini-api/docs/models
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Embedding model (text only). Full output size is 3072 dimensions.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: shrink embeddings with Matryoshka truncation (128-3072).
# Leave empty for the full 3072 dimensions.
# The API normalizes only 3072-d outputs; smaller vectors are
# re-normalized by llm_series/config.py so they stay on the unit sphere.
GEMINI_EMBEDDING_DIM=

# --- Tavily web search (optional, projects 04 and 05) ----------------
# Free tier: https://app.tavily.com
# Without it the agents simply run without the web search tool.
TAVILY_API_KEY=
